SECRET_KEY=replace-with-your-own-development-secret
DEBUG=True
USE_POSTGRES=True
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sp500_platform
DB_USER=sp500_user
DB_PASSWORD=replace-with-local-database-password
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:5173
# Console email is for local testing. Configure SMTP to deliver real messages.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
